PENN_PUBLIC_URL=https://penn.<VPS-IP>.sslip.io
# Generate with: python -c 'import secrets; print("/" + secrets.token_urlsafe(32))'
PENN_PREFIX=
# Exact callbacks from each client setup; no wildcards. Comma-separated.
PENN_OAUTH_REDIRECTS=
# Verify from the actual PennKey redirect before enabling credential capture.
PENN_LOGIN_HOSTS=
PENN_EXPECTED_USER_ID=
